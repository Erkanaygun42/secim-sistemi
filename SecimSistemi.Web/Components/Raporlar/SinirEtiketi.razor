@* Sınır durumu etiketi. Donem verilirse karşılaştırılabilir dönemin özeti ("Şüpheli (2019)"; uyarı varsa asla "Sabit"),
   Yillik verilirse yalnızca o seçimin tespiti (sınır geçmişi tablosu). Üzerine gelince açıklama görünür. *@

@if (Donem is { } d)
{
    <MudTooltip Text="@Metinler.SinirAciklamasi(d)">
        <MudChip T="string" Size="Size.Small" Color="@Renk(d.Durum, d.Dogrulandi)" Variant="@(d.Durum == SinirDurumu.Sabit && !d.Dogrulandi ? Variant.Text : Variant.Outlined)">
            @Metinler.Sinir(d)
        </MudChip>
    </MudTooltip>
}
else if (Yillik is { } y)
{
    <MudTooltip Text="@Metinler.SinirAciklamasi(y)">
        <MudChip T="string" Size="Size.Small" Color="@Renk(y.Sonuc, y.Dogrulandi)" Variant="@(y.Sonuc == SinirDurumu.Sabit && !y.Dogrulandi ? Variant.Text : Variant.Outlined)">
            @Metinler.Sinir(y)
        </MudChip>
    </MudTooltip>
}
else
{
    <span title="Birim sınır analizinde yok">@Metinler.Bos</span>
}

@code {
    [Parameter] public DonemSiniri? Donem { get; set; }
    [Parameter] public BirimYilDurumu? Yillik { get; set; }

    private static Color Renk(SinirDurumu d, bool dogrulandi) => d switch
    {
        SinirDurumu.Supheli => Color.Warning,
        _ when dogrulandi => Color.Success,
        SinirDurumu.SiniriDegisti => Color.Error,
        SinirDurumu.Yeni => Color.Info,
        _ => Color.Default,
    };
}
