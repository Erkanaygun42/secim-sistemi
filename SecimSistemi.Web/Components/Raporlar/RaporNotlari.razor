@* Rapor sayfalarının altındaki notlar: rapora özel maddeler ve ortak notlar (veri kaynağı, sınır eşikleri, eşleme sınırı).
   Metinler RaporBelgeleri'nden gelir; Excel ve PDF'teki notlarla aynıdır. *@

<MudPaper Outlined="true" Class="pa-4 mt-4 rapor-notlari">
    <MudText Typo="Typo.subtitle2" GutterBottom="true">Notlar</MudText>
    <ul>
        @foreach (var m in Maddeler.Concat(RaporBelgeleri.OrtakNotlar(Esikler)))
        {
            <li>@m</li>
        }
    </ul>
</MudPaper>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<string> Maddeler { get; set; } = [];
    [Parameter] public SinirEsikleri? Esikler { get; set; }
}
