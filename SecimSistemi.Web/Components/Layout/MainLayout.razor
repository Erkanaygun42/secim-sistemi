@inherits LayoutComponentBase

<MudThemeProvider Theme="Tema.Uygulama" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@(() => _menuAcik = !_menuAcik)" aria-label="Menüyü aç/kapat" />
        <MudText Typo="Typo.h6" Class="ml-2">DSP Seçim Analizi</MudText>
        <MudSpacer />
        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">Partiye özel</MudChip>
    </MudAppBar>
    <MudDrawer @bind-Open="_menuAcik" ClipMode="DrawerClipMode.Always" Elevation="1">
        <NavMenu />
    </MudDrawer>
    <MudMainContent Class="pt-16 px-6 pb-6">
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    Beklenmeyen bir hata oluştu.
    <a href="." class="reload">Yenile</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _menuAcik = true;
}
