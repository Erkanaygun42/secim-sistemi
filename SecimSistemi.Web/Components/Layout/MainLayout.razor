@inherits LayoutComponentBase
@inject Gorunum Gorunum

<MudThemeProvider Theme="_tema" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true" Class="ust-cubuk" Style="@($"border-bottom: 3px solid {Gorunum.AnaRenk};")">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@(() => _menuAcik = !_menuAcik)" aria-label="Menüyü aç/kapat" />
        <a href="" class="logo-baglantisi"><img src="@Gorunum.LogoAdresi" alt="Demokratik Sol Parti" class="logo" /></a>
        <MudText Typo="Typo.h6" Class="ml-3">Seçim Analizi</MudText>
        <MudSpacer />
        <span class="partiye-ozel" style="@($"background: {Gorunum.AnaRenk}; color: {Gorunum.BantYazisi};")">Partiye özel</span>
    </MudAppBar>
    <MudDrawer @bind-Open="_menuAcik" ClipMode="DrawerClipMode.Always" Elevation="1">
        <NavMenu />
    </MudDrawer>
    <MudMainContent Class="pt-16 px-6 pb-6">
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    Beklenmeyen bir hata oluştu.
    <a href="." class="reload">Yenile</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _menuAcik = true;
    private MudTheme _tema = default!;

    protected override void OnInitialized() => _tema = Tema.Olustur(Gorunum);
}
