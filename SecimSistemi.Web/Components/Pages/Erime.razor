@page "/erime"
@inject ErimeHazirlayici Hazirlayici
@inject NavigationManager Nav

<PageTitle>Erime raporu</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Erime raporu</MudText>

@if (_sonuc is null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (_sonuc.Ilce is not { } ilce || _sonuc.Seriler.Count == 0)
{
    <MudAlert Severity="Severity.Info">Veritabanında yerel seçim verisi yok. Önce <code>yukle-hepsi</code> komutuyla YSK dosyalarını yükleyin.</MudAlert>
}
else
{
    <MudPaper Outlined="true" Class="pa-4 mb-4">
        <div class="filtreler">
            <MudSelect T="string" Label="İlçe" Value="@ilce.Kod" ValueChanged="IlceDegisti" Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (var i in _sonuc.Ilceler)
                {
                    <MudSelectItem Value="@i.Kod">@i.IlAdi / @i.Ad</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" Label="Mahalle tablosunda oy türü" Value="@Metinler.Kod(_sonuc.OyTuru)" ValueChanged="OyTuruDegisti"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (var o in _sonuc.Seriler)
                {
                    <MudSelectItem Value="@Metinler.Kod(o)">@Metinler.Ad(o)</MudSelectItem>
                }
            </MudSelect>
            <MudSpacer />
            <DisaAktarButonlari Rapor="erime" Sorgu="@_sonuc.Sorgu.SorguMetni()" />
        </div>
    </MudPaper>

    @* ---------- 1. İlçe düzeyi, uzun dönem ---------- *@
    <MudText Typo="Typo.h5" Class="mb-1">İlçe düzeyi · @ErimeHesabi.TabanYili'dan bugüne</MudText>
    <MudText Typo="Typo.body2" Class="mb-3">
        @ilce.Ad ilçesinin tamamı. İlçe sınırı bu dönemde değişmedi; bu yüzden uzun dönem karşılaştırma ilçe düzeyinde yapılır.
    </MudText>
    <GrafikKutusu Grafik="RaporGrafikleri.IlceOrani(_sonuc)" />
    <MudSimpleTable Dense="true" Bordered="true" Class="mb-2">
        <thead>
            <tr>
                <SutunBasligi Tanim="SutunSozlugu.Seri" />
                <SutunBasligi Tanim="SutunSozlugu.Yil" Sag="true" />
                <SutunBasligi Tanim="SutunSozlugu.ToplamOy" Sag="true" />
                <SutunBasligi Tanim="SutunSozlugu.DspOyu" Sag="true" />
                <SutunBasligi Tanim="SutunSozlugu.DspOrani" Sag="true" />
                <SutunBasligi Baslik="@PuanBasligi" Tanim="SutunSozlugu.PuanTabana" Sag="true" />
                <SutunBasligi Tanim="SutunSozlugu.Korunma" Sag="true" />
                <SutunBasligi Baslik="Beklenen oy" Tanim="SutunSozlugu.Beklenen" Sag="true" />
                <SutunBasligi Baslik="Kayıp oy" Tanim="SutunSozlugu.Kayip" Sag="true" />
            </tr>
        </thead>
        <tbody>
            @foreach (var (seri, satirlar) in _sonuc.IlceErimesi.OrderBy(kv => Metinler.SeriSirasi(kv.Key)))
            {
                @foreach (var (s, i) in satirlar.Select((s, i) => (s, i)))
                {
                    <tr class="@(i == satirlar.Count - 1 ? "satir-son" : "")">
                        @if (i == 0)
                        {
                            <td rowspan="@satirlar.Count"><b>@Metinler.Ad(seri)</b></td>
                        }
                        <td class="sayi">@s.Yil</td>
                        <td class="sayi">@Metinler.Oy(s.ToplamOy)</td>
                        <td class="sayi">@Metinler.Oy(s.DspOyu)</td>
                        <td class="sayi">@Metinler.Oran(s.Oran)</td>
                        <td class="sayi">@Metinler.Puan(s.PuanFarki)</td>
                        <td class="sayi">@Metinler.Katsayi(s.KorunmaOrani)</td>
                        <td class="sayi">@Metinler.Oy(s.BeklenenOy)</td>
                        <td class="sayi">@Metinler.Oy(s.KayipOy)</td>
                    </tr>
                }
            }
        </tbody>
    </MudSimpleTable>

    @* ---------- 2. Mahalle düzeyi, dönemli ---------- *@
    var rapor = _sonuc.Rapor!;
    <MudText Typo="Typo.h5" Class="mt-6 mb-1">Mahalle düzeyi · @Metinler.Ad(_sonuc.OyTuru) · son seçim @(rapor.SonYil?.ToString() ?? Metinler.Bos)</MudText>
    <MudText Typo="Typo.body2" Class="mb-3">
        Her birimin tabanı kendi karşılaştırılabilir döneminin ilk seçimidir (son sınır değişikliğinden bugüne).
        Sıra: dönem (en uzun önce), sonra kayıp oy (en büyük önce).
    </MudText>
    @foreach (var g in RaporGrafikleri.EnCokKaybedenler(_sonuc))
    {
        <GrafikKutusu Grafik="g" />
    }
    var yillar = RaporBelgeleri.MahalleYillari(_sonuc);
    var sutunSayisi = 11 + yillar.Count;
    <MudText Typo="Typo.body2" Class="mb-2">Gri ve boş hücre: o yıl mahallenin karşılaştırılabilir döneminin dışında.</MudText>
    <MudSimpleTable Dense="true" Hover="true" Bordered="true" Class="genis-tablo">
        <thead>
            <tr>
                <th class="sayi">#</th>
                <SutunBasligi Tanim="SutunSozlugu.Kod" />
                <SutunBasligi Tanim="SutunSozlugu.Mahalle" />
                @foreach (var y in yillar)
                {
                    <SutunBasligi Baslik="@YilBasligi(y)" Tanim="SutunSozlugu.YilOrani" Sag="true" />
                }
                <SutunBasligi Tanim="SutunSozlugu.PuanTabana" Sag="true" />
                <SutunBasligi Tanim="SutunSozlugu.Korunma" Sag="true" />
                <SutunBasligi Tanim="SutunSozlugu.TabanDsp" Sag="true" />
                <SutunBasligi Tanim="SutunSozlugu.SonDsp" Sag="true" />
                <SutunBasligi Tanim="SutunSozlugu.SonToplam" Sag="true" />
                <SutunBasligi Tanim="SutunSozlugu.Beklenen" Sag="true" />
                <SutunBasligi Tanim="SutunSozlugu.Kayip" Sag="true" />
                <SutunBasligi Tanim="SutunSozlugu.Kale" />
            </tr>
        </thead>
        <tbody>
            @{ var sira = 0; }
            @foreach (var grup in _sonuc.DonemGruplari())
            {
                <tr class="satir-grup">
                    <td colspan="@sutunSayisi">Karşılaştırılabilir dönem <b>@grup.Key</b> · @grup.Count() birim<Ipucu Tanim="SutunSozlugu.Donem" /></td>
                </tr>
                @foreach (var s in grup)
                {
                    sira++;
                    var uyari = _sonuc.Uyari(s.BirimKod);
                    <tr class="@(uyari is null ? "" : "satir-supheli")">
                        <td class="sayi">@sira</td>
                        <td>@s.BirimKod</td>
                        <td>
                            <MudLink Href="@($"mahalle/{ilce.Kod}/{s.BirimKod}")">@s.BirimAdi</MudLink>
                            @if (uyari is not null)
                            {
                                <MudTooltip Text="@uyari">
                                    <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Small" Class="ml-1" />
                                </MudTooltip>
                            }
                        </td>
                        @foreach (var y in yillar)
                        {
                            if (s.DonemDisi(y))
                            {
                                <td class="donem-disi" title="@DonemDisiIpucu(y, grup.Key)"></td>
                            }
                            else
                            {
                                <td class="sayi">@Metinler.Oran(s.YillikOranlar.GetValueOrDefault(y))</td>
                            }
                        }
                        <td class="sayi">@Metinler.Puan(s.PuanFarki)</td>
                        <td class="sayi">@Metinler.Katsayi(s.KorunmaOrani)</td>
                        <td class="sayi">@Metinler.Oy(s.TabanDspOyu)</td>
                        <td class="sayi">@Metinler.Oy(s.SonDspOyu)</td>
                        <td class="sayi">@Metinler.Oy(s.SonToplamOy)</td>
                        <td class="sayi">@Metinler.Oy(s.BeklenenOy)</td>
                        <td class="sayi"><b>@Metinler.Oy(s.KayipOy)</b></td>
                        <td>@(s.KaleMi ? "evet" : "")</td>
                    </tr>
                }
            }
        </tbody>
    </MudSimpleTable>
    @foreach (var g in rapor.Satirlar.Where(s => s.Not is not null).GroupBy(s => s.Not!))
    {
        <MudText Typo="Typo.body2" Class="mt-1">Not (@g.Count() birim): @g.Key</MudText>
    }

    @* ---------- 3. Kaleler ---------- *@
    <MudText Typo="Typo.h5" Class="mt-6 mb-1">@ErimeHesabi.TabanYili kaleleri<Ipucu Tanim="SutunSozlugu.Kale" /></MudText>
    <MudText Typo="Typo.body2">@SutunSozlugu.Kale.Aciklama @(_sonuc.KaleOzeti).</MudText>
    <MudText Typo="Typo.body2" Class="mb-3">Grubun ağırlıklı oranı (grubun DSP oyu ÷ grubun toplam oyu), yüzde:</MudText>
    var kaleYillari = _sonuc.Raporlar.Values.SelectMany(r => r.KaleOrtalamalari.Select(k => k.Yil)).Distinct().Order().ToList();
    <MudSimpleTable Dense="true" Bordered="true" Style="max-width: 640px">
        <thead>
            <tr>
                <SutunBasligi Tanim="SutunSozlugu.Seri" />
                @foreach (var y in kaleYillari)
                {
                    <SutunBasligi Baslik="@YilBasligi(y)" Tanim="SutunSozlugu.KaleOrani" Sag="true" />
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var (seri, r) in _sonuc.Raporlar.OrderBy(kv => Metinler.SeriSirasi(kv.Key)))
            {
                <tr>
                    <td>@Metinler.Ad(seri)</td>
                    @foreach (var y in kaleYillari)
                    {
                        <td class="sayi">@Metinler.Oran(r.KaleOrtalamalari.FirstOrDefault(k => k.Yil == y)?.Oran)</td>
                    }
                </tr>
            }
        </tbody>
    </MudSimpleTable>

    <RaporNotlari Maddeler="RaporBelgeleri.ErimeNotlari" Esikler="_sonuc.Sinir?.Esikler" />
}

@code {
    [SupplyParameterFromQuery(Name = "ilce")] public string? Ilce { get; set; }
    [SupplyParameterFromQuery(Name = "oy-turu")] public string? OyTuru { get; set; }

    private ErimeSonucu? _sonuc;

    private static readonly string PuanBasligi = $"Puan ({Metinler.Yonelme(ErimeHesabi.TabanYili)} göre)";
    private static string YilBasligi(int y) => $"{y} %";
    private static string DonemDisiIpucu(int y, string donem) => $"{y}: karşılaştırılabilir dönemin ({donem}) dışında";

    protected override async Task OnParametersSetAsync() =>
        _sonuc = await Hazirlayici.HazirlaAsync(new ErimeSorgusu(Ilce, OyTuru));

    private void Git(ErimeSorgusu s) => Nav.NavigateTo(Nav.GetUriWithQueryParameters(s.Parametreler()));
    private void IlceDegisti(string kod) => Git(_sonuc!.Sorgu with { Ilce = kod });
    private void OyTuruDegisti(string kod) => Git(_sonuc!.Sorgu with { OyTuru = kod });
}
