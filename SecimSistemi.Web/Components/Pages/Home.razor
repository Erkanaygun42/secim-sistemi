@page "/"

<PageTitle>DSP Seçim Analizi</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">DSP Seçim Analizi</MudText>
<MudText Class="mb-6">
    YSK sandık sonuçlarından mahalle/köy düzeyinde DSP'nin gücü, erimesi ve sınır değişiklikleri.
</MudText>

<MudGrid>
    <MudItem xs="12" md="6">
        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h6">Mahalle karnesi</MudText>
                <MudText Typo="Typo.body2">Seçilen ilçe, seçim ve oy türünde her mahallenin DSP oyu, oranı ve sınır durumu.</MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Href="karne" Color="Color.Primary">Aç</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h6">Erime raporu</MudText>
                <MudText Typo="Typo.body2">İlçe düzeyinde 2009'dan bugüne, mahalle düzeyinde karşılaştırılabilir dönemde kayıp oy.</MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Href="erime" Color="Color.Primary">Aç</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
    @foreach (var (baslik, metin, adres) in new[]
    {
        ("Mahalle grupları", "Kale, erozyon, yükselen, zayıf; bugünkü güç ve eğilim (2x2).", "gruplar"),
        ("Öncelik listesi", "Dönem başına kayıp oya göre sıralı mahalleler; her satırda neden öncelikli olduğu.", "oncelik"),
        ("Meclis hesaplayıcı", "Belediye meclisi üye dağılımı ve DSP'nin kaç oy daha alsaydı kaç üye çıkaracağı.", "meclis"),
    })
    {
        <MudItem xs="12" md="4">
            <MudCard>
                <MudCardContent>
                    <MudText Typo="Typo.h6">@baslik</MudText>
                    <MudText Typo="Typo.body2">@metin</MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Href="@adres" Color="Color.Primary">Aç</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    }
</MudGrid>
