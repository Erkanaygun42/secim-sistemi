<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["SecimSistemi.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="SayfaModu" />
</head>

<body>
    <Routes @rendermode="SayfaModu" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Sayfalar etkileşimli (InteractiveServer) çalışır: filtre değişince sayfa yenilenmeden tablo güncellenir.
    // [ExcludeFromInteractiveRouting] taşıyan sayfalar (Error) düz sunucu çıktısı olarak kalır.
    private IComponentRenderMode? SayfaModu =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
