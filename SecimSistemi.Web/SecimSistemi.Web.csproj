<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\SecimSistemi.Data\SecimSistemi.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Playwright" Version="1.65.1" />
    <PackageReference Include="MudBlazor" Version="9.14.0" />
  </ItemGroup>

  <!-- Meclis üye sayıları tek dosyada (Importer/Tanimlar); uygulama çıktı klasöründeki kopyasını okur. -->
  <ItemGroup>
    <None Include="..\SecimSistemi.Importer\Tanimlar\meclis-uye-sayilari.csv" Link="Tanimlar\meclis-uye-sayilari.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\SecimSistemi.Importer\Tanimlar\harita-eslemeleri.csv" Link="Tanimlar\harita-eslemeleri.csv" CopyToOutputDirectory="PreserveNewest" />
    <!-- Mahalle sınırları (OpenStreetMap, ODbL): harita-sinirlari komutu yazar, uygulama çıktı klasöründen okur. -->
    <None Include="Harita\*.geojson" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>8ca36aa4-2403-4f25-b165-b4e3cd6e8418</UserSecretsId>
  </PropertyGroup>

</Project>
